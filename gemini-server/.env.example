# Gemini API Key (IMPORTANT: DO NOT COMMIT)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Custom API server URL (defaults to http://localhost:3001)
# VITE_API_URL=http://localhost:3001

# Optional: Custom client URL for CORS (defaults to http://localhost:5173)
# CLIENT_URL=http://localhost:5173

# Optional: Server port (defaults to 3001)
# PORT=3001
